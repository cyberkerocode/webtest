{
  "manifest_version": 3,
  "name": "TL;DR Crawler",
  "version": "1.0.0",
  "description": "有隻線條畫嘅蜘蛛喺網頁度爬,搵出重要句子,一路爬一路砌出個 TL;DR 面板。",
  "permissions": ["activeTab", "scripting", "storage", "webNavigation", "contextMenus"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TL;DR Crawler:開始/停止隻蜘蛛",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "開始/停止 TL;DR Crawler(同撳 toolbar icon 一樣)"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "102"
}
